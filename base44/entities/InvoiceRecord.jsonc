{
  "name": "InvoiceRecord",
  "properties": {
    "billing_block_id": {
      "description": "Linked ProjectBillingBlock ID",
      "type": "string"
    },
    "confirmed_order_id": {
      "description": "Linked ConfirmedOrder ID",
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "gross_amount": {
      "default": 0,
      "type": "number"
    },
    "invoice_date": {
      "format": "date",
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_type": {
      "default": "partial_invoice",
      "enum": [
        "final_invoice",
        "partial_invoice",
        "advance_invoice",
        "correction",
        "credit_note"
      ],
      "type": "string"
    },
    "is_credit_note": {
      "default": false,
      "type": "boolean"
    },
    "is_sent": {
      "default": false,
      "description": "true = Rechnung wurde in sevDesk versendet/festgeschrieben (nicht mehr Entwurf). Nur versendete, nicht stornierte Rechnungen fliessen in die Liquiditaetsuebersicht.",
      "type": "boolean"
    },
    "liquiditaet_notiz": {
      "description": "Begr\u00fcndung / Fundstelle zum Liquidit\u00e4tsstatus",
      "type": "string"
    },
    "liquiditaet_status": {
      "default": "normal",
      "description": "F\u00fchrung in der Betriebsliquidit\u00e4t, unabh\u00e4ngig von sevDesk: bezahlt_* = bereits im Kontostand, nicht mehr als Eingang planen; ungeklaert = planen, aber als Risiko Doppelz\u00e4hlung zeigen; nicht_einplanen = bewusst drau\u00dfen",
      "enum": [
        "normal",
        "bezahlt_belegt",
        "bezahlt_wahrscheinlich",
        "ungeklaert",
        "nicht_einplanen"
      ],
      "type": "string"
    },
    "match_confidence": {
      "default": 0,
      "description": "0-100 confidence score",
      "type": "number"
    },
    "match_notes": {
      "type": "string"
    },
    "match_status": {
      "default": "unmatched",
      "enum": [
        "auto_matched",
        "manually_matched",
        "unmatched",
        "disputed"
      ],
      "type": "string"
    },
    "net_amount": {
      "default": 0,
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "open_amount": {
      "default": 0,
      "type": "number"
    },
    "original_invoice_id": {
      "description": "For corrections/credit notes: points to original InvoiceRecord ID",
      "type": "string"
    },
    "paid_amount": {
      "default": 0,
      "type": "number"
    },
    "payment_date": {
      "format": "date",
      "type": "string"
    },
    "payment_status": {
      "default": "open",
      "description": "draft = Entwurf in sevDesk (noch nicht versendet)",
      "enum": [
        "draft",
        "open",
        "partially_paid",
        "paid",
        "overdue",
        "cancelled",
        "unclear"
      ],
      "type": "string"
    },
    "project_id": {
      "description": "Linked LiquidityProject ID",
      "type": "string"
    },
    "sevdesk_id": {
      "description": "sevDesk Rechnungs-ID",
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "source_type": {
      "default": "manual",
      "enum": [
        "manual",
        "excel",
        "sevdesk",
        "csv",
        "pdf",
        "other"
      ],
      "type": "string"
    },
    "vat_amount": {
      "default": 0,
      "type": "number"
    },
    "vat_rate": {
      "default": 20,
      "type": "number"
    }
  },
  "required": [
    "customer_name"
  ],
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}