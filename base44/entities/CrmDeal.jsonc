{
  "name": "CrmDeal",
  "type": "object",
  "properties": {
    "pipeline": {
      "type": "string",
      "enum": [
        "new_business",
        "existing_customer"
      ],
      "default": "new_business",
      "description": "Neukunden-Sales oder Bestandskunden-Anfrage"
    },
    "stage": {
      "type": "string",
      "enum": [
        "new_lead",
        "contacted",
        "meeting_scheduled",
        "meeting_confirmed",
        "proposal_sent",
        "negotiation",
        "won",
        "lost",
        "inquiry_received",
        "evaluated",
        "estimated",
        "ordered",
        "declined"
      ],
      "default": "new_lead"
    },
    "title": {
      "type": "string",
      "description": "Deal-Bezeichnung"
    },
    "company_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "phone_ai",
        "email",
        "manual",
        "referral",
        "website",
        "other"
      ],
      "default": "manual"
    },
    "value_net": {
      "type": "number",
      "default": 0,
      "description": "Erwarteter Auftragswert netto EUR"
    },
    "probability_percent": {
      "type": "number",
      "default": 50
    },
    "expected_close_date": {
      "type": "string",
      "format": "date"
    },
    "next_step": {
      "type": "string",
      "description": "Konkreter n\u00e4chster Schritt"
    },
    "next_step_date": {
      "type": "string",
      "format": "date"
    },
    "lost_reason": {
      "type": "string"
    },
    "closed_at": {
      "type": "string",
      "format": "date"
    },
    "sevdesk_contact_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung zum sevDesk-Kunden (Bestandskunden)"
    },
    "linked_customer_name": {
      "type": "string",
      "description": "Kundenname wie in InvoiceRecord/LiquidityProject"
    },
    "liquidity_project_id": {
      "type": "string",
      "description": "Optional: entstandenes LiquidityProject nach Gewinn"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "company_website": {
      "type": "string",
      "description": "Website der Firma (Stammdaten)"
    },
    "company_address": {
      "type": "string",
      "description": "Firmenadresse (Stammdaten)"
    },
    "company_industry": {
      "type": "string",
      "description": "Branche (Stammdaten)"
    },
    "company_size": {
      "type": "string",
      "description": "Firmengr\u00f6\u00dfe, z.B. Mitarbeiteranzahl (Stammdaten)"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "enriched",
        "insufficient_data",
        "error"
      ],
      "default": "pending",
      "description": "Status der automatischen Stammdaten-Pr\u00fcfung/Recherche"
    },
    "enrichment_summary": {
      "type": "string",
      "description": "Kurzzusammenfassung der Web-Recherche"
    },
    "enriched_at": {
      "type": "string",
      "format": "date-time"
    },
    "contact_position": {
      "type": "string",
      "description": "Position/Rolle des Ansprechpartners (LinkedIn-Recherche)"
    },
    "contact_linkedin_url": {
      "type": "string",
      "description": "LinkedIn-Profil-URL des Ansprechpartners"
    },
    "contact_background": {
      "type": "string",
      "description": "Kurzprofil des Ansprechpartners aus LinkedIn/Web-Recherche"
    },
    "seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Wann der Deal zum ersten Mal ge\u00f6ffnet wurde \u2014 leer = NEU in der Pipeline"
    },
    "proposal_id": {
      "type": "string",
      "description": "Verkn\u00fcpftes Angebot im Angebots-Studio (CrmProposal)"
    }
  },
  "required": [
    "title",
    "pipeline"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}