{
  "name": "ConfirmedOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Linked LiquidityProject ID"
    },
    "order_number": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "confirmation_date": {
      "type": "string",
      "format": "date"
    },
    "signed_date": {
      "type": "string",
      "format": "date"
    },
    "total_net_amount": {
      "type": "number",
      "default": 0
    },
    "total_gross_amount": {
      "type": "number",
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "payment_terms": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "cancelled",
        "unclear",
        "completed"
      ],
      "default": "confirmed"
    },
    "document_url": {
      "type": "string"
    },
    "responsible_project_manager": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "excel",
        "pdf",
        "sevdesk",
        "other"
      ],
      "default": "manual"
    },
    "notes": {
      "type": "string"
    },
    "sevdesk_order_id": {
      "type": "string",
      "description": "sevDesk interne Auftrags-ID"
    },
    "sevdesk_contact_id": {
      "type": "string",
      "description": "sevDesk Kontakt-ID des Kunden \u2014 wird f\u00fcr Rechnungsverkn\u00fcpfung ben\u00f6tigt"
    },
    "awork_project_id": {
      "type": "string"
    },
    "awork_project_name": {
      "type": "string"
    },
    "awork_match_status": {
      "type": "string",
      "enum": [
        "manual",
        "suggested",
        "unmatched",
        "ignored"
      ],
      "default": "unmatched"
    },
    "awork_last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "awork_project_status": {
      "type": "string"
    },
    "awork_progress_percent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "customer",
    "project_name"
  ]
}