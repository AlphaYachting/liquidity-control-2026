{
  "name": "ConfirmedOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Projekt-ID. Auftr\u00e4ge aus dem CRM-\u00dcbergabeblatt: Project.id. Altbestand: LiquidityProject.id."
    },
    "deal_id": {
      "type": "string",
      "description": "R\u00fcckverkn\u00fcpfung zum CrmDeal, aus dem der Auftrag entstanden ist"
    },
    "proposal_id": {
      "type": "string",
      "description": "R\u00fcckverkn\u00fcpfung zum CrmProposal (Angebots-Studio)"
    },
    "advance_percent": {
      "type": "number",
      "default": 30,
      "description": "Anzahlungsanteil in Prozent"
    },
    "order_number": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "confirmation_date": {
      "type": "string",
      "format": "date"
    },
    "signed_date": {
      "type": "string",
      "format": "date"
    },
    "total_net_amount": {
      "type": "number",
      "default": 0
    },
    "total_gross_amount": {
      "type": "number",
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "payment_terms": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "cancelled",
        "unclear",
        "completed"
      ],
      "default": "confirmed"
    },
    "document_url": {
      "type": "string"
    },
    "responsible_project_manager": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "excel",
        "pdf",
        "sevdesk",
        "other"
      ],
      "default": "manual"
    },
    "notes": {
      "type": "string"
    },
    "sevdesk_order_id": {
      "type": "string",
      "description": "sevDesk interne Auftrags-ID (Auftragsbest\u00e4tigung)"
    },
    "sevdesk_order_url": {
      "type": "string",
      "description": "Direktlink zur Auftragsbest\u00e4tigung in sevDesk"
    },
    "sevdesk_quote_id": {
      "type": "string",
      "description": "sevDesk-ID des vorgelagerten Angebots"
    },
    "sevdesk_quote_number": {
      "type": "string",
      "description": "Angebotsnummer in sevDesk"
    },
    "sevdesk_contact_id": {
      "type": "string",
      "description": "sevDesk Kontakt-ID des Kunden \u2014 wird f\u00fcr Rechnungsverkn\u00fcpfung ben\u00f6tigt"
    },
    "awork_project_id": {
      "type": "string"
    },
    "awork_project_name": {
      "type": "string"
    },
    "awork_match_status": {
      "type": "string",
      "enum": [
        "manual",
        "suggested",
        "unmatched",
        "ignored"
      ],
      "default": "unmatched"
    },
    "awork_last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "awork_project_status": {
      "type": "string"
    },
    "awork_progress_percent": {
      "type": "number",
      "default": 0
    },
    "angebot_url": {
      "type": "string",
      "description": "Datei-URL des vom Kunden angenommenen Angebots (PDF)"
    },
    "angebot_nummer": {
      "type": "string"
    },
    "angebot_datum": {
      "type": "string",
      "format": "date"
    },
    "angebot_quelle": {
      "type": "string",
      "enum": [
        "studio",
        "email_angebot",
        "extern_pdf",
        "manuell"
      ]
    },
    "leistungszeitraum": {
      "type": "string",
      "description": "Vereinbarte Dauer bzw. Zeitplan im Wortlaut des Angebots"
    },
    "liefertermin": {
      "type": "string",
      "format": "date",
      "description": "Vereinbarter Liefer- oder Fertigstellungstermin, falls im Angebot genannt"
    },
    "korrekturschleifen": {
      "type": "number",
      "description": "Vereinbarte Korrekturschleifen je Leistungspaket f\u00fcr den ganzen Auftrag"
    },
    "mehrkosten_regel": {
      "type": "string",
      "description": "Wie Mehraufwand verrechnet wird, Wortlaut aus dem Angebot"
    },
    "nicht_enthalten": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ausdr\u00fccklich nicht enthaltene Leistungen"
    },
    "ab_pdf_url": {
      "type": "string",
      "description": "PDF-Kopie der Auftragsbest\u00e4tigung"
    },
    "umfang_geprueft_von": {
      "type": "string",
      "description": "Wer den Umfang im \u00dcbergabeblatt freigegeben hat"
    },
    "umfang_geprueft_am": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer",
    "project_name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}