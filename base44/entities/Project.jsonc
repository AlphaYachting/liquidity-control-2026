{
  "name": "Project",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "pm_email": {
      "type": "string",
      "format": "email",
      "description": "verantwortlicher Projektmanager"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktiv",
        "pausiert",
        "abgeschlossen"
      ],
      "default": "aktiv"
    },
    "total_budget": {
      "type": "number",
      "description": "Netto in EUR \u00fcber alle Sprints"
    },
    "abrechnungsmodell": {
      "type": "string",
      "enum": [
        "sprint",
        "support",
        "aufwand",
        "paket",
        "intern"
      ],
      "default": "sprint",
      "description": "tr\u00e4gt die Kategorie jeder Zeitbuchung"
    },
    "stundensatz": {
      "type": "number",
      "description": "nur relevant bei Abrechnung nach Aufwand"
    },
    "support_kontingent_stunden": {
      "type": "number",
      "description": "monatliches Stundenkontingent bei Support"
    }
  },
  "required": [
    "client_id",
    "title",
    "pm_email"
  ]
}