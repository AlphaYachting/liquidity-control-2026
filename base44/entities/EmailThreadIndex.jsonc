{
  "name": "EmailThreadIndex",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "ID des Verlaufs in der zentralen E-Mail-Datenbank"
    },
    "subject": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "crm_status": {
      "type": "string"
    },
    "first_message_at": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "last_direction": {
      "type": "string"
    },
    "last_from": {
      "type": "string"
    },
    "last_from_name": {
      "type": "string"
    },
    "last_to": {
      "type": "string"
    },
    "last_inbound_from": {
      "type": "string"
    },
    "has_outbound": {
      "type": "boolean",
      "default": false
    },
    "needs_reply": {
      "type": "boolean",
      "default": false,
      "description": "erf\u00fcllt die Triage-Kriterien \u2014 Basis der Arbeitsliste"
    },
    "detail_loaded": {
      "type": "boolean",
      "default": false,
      "description": "Nachrichten des Verlaufs wurden gelesen (Richtung/Antwortstand belegt)"
    },
    "indexed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "fenster",
        "nachlauf"
      ],
      "default": "fenster",
      "description": "\u00fcber das laufende Zeitfenster oder den historischen Nachlauf erfasst"
    }
  },
  "required": [
    "thread_id"
  ]
}