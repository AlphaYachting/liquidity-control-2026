{
  "name": "EmailThreadIndex",
  "properties": {
    "category": {
      "type": "string"
    },
    "conversation_key": {
      "description": "normalisierter Betreff + Gegenstelle \u2014 fasst Parallel-Verl\u00e4ufe derselben Konversation zusammen",
      "type": "string"
    },
    "conversation_size": {
      "default": 1,
      "description": "Anzahl Verl\u00e4ufe in dieser Konversation",
      "type": "number"
    },
    "crm_status": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "detail_loaded": {
      "default": false,
      "description": "Nachrichten des Verlaufs wurden gelesen (Richtung/Antwortstand belegt)",
      "type": "boolean"
    },
    "done_at": {
      "description": "Zeitpunkt der letzten Erledigt-/Antwort-Aktion aus der App \u2014 gilt bis zur n\u00e4chsten Kundennachricht",
      "format": "date-time",
      "type": "string"
    },
    "first_message_at": {
      "type": "string"
    },
    "has_outbound": {
      "default": false,
      "type": "boolean"
    },
    "indexed_at": {
      "format": "date-time",
      "type": "string"
    },
    "last_direction": {
      "type": "string"
    },
    "last_from": {
      "type": "string"
    },
    "last_from_name": {
      "type": "string"
    },
    "last_inbound_from": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "last_to": {
      "type": "string"
    },
    "message_count": {
      "default": 0,
      "type": "number"
    },
    "needs_reply": {
      "default": false,
      "description": "Konversation ist unbeantwortet \u2014 genau ein Verlauf je offener Konversation (der j\u00fcngste). Quelle des Posteingangs",
      "type": "boolean"
    },
    "source": {
      "default": "fenster",
      "description": "\u00fcber das laufende Zeitfenster oder den historischen Nachlauf erfasst",
      "enum": [
        "fenster",
        "nachlauf"
      ],
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "thread_id": {
      "description": "ID des Verlaufs in der zentralen E-Mail-Datenbank",
      "type": "string"
    }
  },
  "required": [
    "thread_id"
  ],
  "type": "object"
}