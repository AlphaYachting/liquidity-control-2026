{
  "name": "Ticket",
  "properties": {
    "assignee_email": {
      "format": "email",
      "type": "string"
    },
    "blocks_others": {
      "default": false,
      "type": "boolean"
    },
    "checklist": {
      "description": "Arbeitsschritte innerhalb des Tickets",
      "items": {
        "properties": {
          "done": {
            "default": false,
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "customer_name": {
      "description": "denormalisierter Kundenname \u2014 tr\u00e4gt die Support-Zuordnung ohne Joins",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fenster_tage": {
      "default": 0,
      "type": "number"
    },
    "last_status_change": {
      "description": "tr\u00e4gt Warnsignal W3 \u2014 bei jedem Statuswechsel setzen",
      "format": "date-time",
      "type": "string"
    },
    "links": {
      "description": "Verweise auf Dateien, Entw\u00fcrfe, Dokumente",
      "items": {
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "milestone_id": {
      "type": "string"
    },
    "milestone_state": {
      "default": "produktion",
      "description": "Phase, in der das Ticket bearbeitet wird \u2014 tr\u00e4gt den Zustandsautomaten und die Livegang-Ausnahme",
      "enum": [
        "input",
        "produktion",
        "pruefung",
        "kundenfeedback"
      ],
      "type": "string"
    },
    "module_template_id": {
      "description": "aus welchem Modul die Aufgabe stammt",
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "origin": {
      "default": "pflicht",
      "enum": [
        "pflicht",
        "addon",
        "change_request",
        "support"
      ],
      "type": "string"
    },
    "planned_for": {
      "description": "F\u00e4lligkeit \u2013 an diesem Tag ist die Aufgabe f\u00e4llig",
      "format": "date",
      "type": "string"
    },
    "project_id": {
      "description": "denormalisiert, damit Zeitbuchung und Heute-Ansicht ohne Joins auskommen",
      "type": "string"
    },
    "rhythmus": {
      "description": "leer = keine Routine",
      "enum": [
        "woechentlich",
        "14taegig",
        "monatlich",
        "2monatlich",
        "quartalsweise",
        "halbjaehrlich",
        "jaehrlich",
        "manuell"
      ],
      "type": "string"
    },
    "rhythmus_anker": {
      "description": "erster Termin der Routine \u2014 bleibt \u00fcber alle Folgetickets gleich",
      "format": "date",
      "type": "string"
    },
    "role": {
      "enum": [
        "Beratung",
        "Konzept",
        "Text",
        "Grafik",
        "Web",
        "Media",
        "QS"
      ],
      "type": "string"
    },
    "source_thread_id": {
      "description": "Verlauf in der E-Mail-Zentrale, aus dem das Ticket entstanden ist",
      "type": "string"
    },
    "status": {
      "default": "offen",
      "enum": [
        "offen",
        "in_arbeit",
        "wartet",
        "erledigt"
      ],
      "type": "string"
    },
    "target_hours": {
      "type": "number"
    },
    "ticket_template_id": {
      "description": "aus welcher Vorlage",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "vorgaenger_id": {
      "description": "das erledigte Ticket, aus dem dieses Folgeticket entstand",
      "type": "string"
    }
  },
  "required": [
    "milestone_id",
    "project_id",
    "title",
    "status"
  ],
  "type": "object"
}