{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "milestone_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "denormalisiert, damit Zeitbuchung und Heute-Ansicht ohne Joins auskommen"
    },
    "order": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "description": "Arbeitsschritte innerhalb des Tickets",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "Verweise auf Dateien, Entw\u00fcrfe, Dokumente",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "assignee_email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "Beratung",
        "Konzept",
        "Text",
        "Grafik",
        "Web",
        "Media",
        "QS"
      ]
    },
    "milestone_state": {
      "type": "string",
      "enum": [
        "input",
        "produktion",
        "pruefung",
        "kundenfeedback"
      ],
      "default": "produktion",
      "description": "Phase, in der das Ticket bearbeitet wird \u2014 tr\u00e4gt den Zustandsautomaten und die Livegang-Ausnahme"
    },
    "status": {
      "type": "string",
      "enum": [
        "offen",
        "in_arbeit",
        "wartet",
        "erledigt"
      ],
      "default": "offen"
    },
    "last_status_change": {
      "type": "string",
      "format": "date-time",
      "description": "tr\u00e4gt Warnsignal W3 \u2014 bei jedem Statuswechsel setzen"
    },
    "origin": {
      "type": "string",
      "enum": [
        "pflicht",
        "addon",
        "change_request",
        "support"
      ],
      "default": "pflicht"
    },
    "source_thread_id": {
      "type": "string",
      "description": "Verlauf in der E-Mail-Zentrale, aus dem das Ticket entstanden ist"
    },
    "customer_name": {
      "type": "string",
      "description": "denormalisierter Kundenname \u2014 tr\u00e4gt die Support-Zuordnung ohne Joins"
    },
    "target_hours": {
      "type": "number"
    },
    "planned_for": {
      "type": "string",
      "format": "date",
      "description": "f\u00fcr welchen Tag eingeplant"
    },
    "blocks_others": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "milestone_id",
    "project_id",
    "title",
    "status"
  ]
}