{
  "name": "ProjectInquiry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Verkn\u00fcpftes LiquidityProject"
    },
    "customer": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string",
      "description": "Umsetzende Person, an die die R\u00fcckfragen gehen"
    },
    "questions_text": {
      "type": "string",
      "description": "Die gestellten Fragen F1\u2013F3 im Klartext"
    },
    "target_fields_json": {
      "type": "string",
      "description": "JSON: Zuordnung F1\u2013F3 zu Zielfeldern (z.B. real_progress_percent)"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "answered",
        "applied",
        "expired"
      ],
      "default": "sent"
    },
    "sent_at": {
      "type": "string",
      "format": "date"
    },
    "answered_at": {
      "type": "string",
      "format": "date"
    },
    "answer_text": {
      "type": "string",
      "description": "Erhaltene Antworten der umsetzenden Person"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "questions_text"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}