{
  "name": "Arbeitstag",
  "properties": {
    "erster_aufruf_am": {
      "description": "Zeitpunkt, an dem die Person das Tool an diesem Tag zum ersten Mal ge\u00f6ffnet hat \u2014 nicht der Arbeitsbeginn",
      "format": "date-time",
      "type": "string"
    },
    "gehen_am": {
      "description": "Ausbaustufe 2: Gehen \u2014 noch nicht genutzt",
      "format": "date-time",
      "type": "string"
    },
    "kommen_am": {
      "description": "Ausbaustufe 2: Kommen \u2014 noch nicht genutzt",
      "format": "date-time",
      "type": "string"
    },
    "person_email": {
      "type": "string"
    },
    "quelle": {
      "default": "app",
      "enum": [
        "app"
      ],
      "type": "string"
    },
    "tag": {
      "description": "Kalendertag (YYYY-MM-DD, Ortszeit)",
      "type": "string"
    }
  },
  "required": [
    "person_email",
    "tag",
    "erster_aufruf_am"
  ],
  "rls": {
    "create": {
      "data.person_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}