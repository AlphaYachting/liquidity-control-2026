{
  "name": "BankBalanceSnapshot",
  "type": "object",
  "properties": {
    "balance_date": {
      "type": "string",
      "format": "date",
      "description": "Stichtag des Bankbestands (Wochenanfang)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Bankanfangsbestand zu diesem Datum (EUR)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "balance_date"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}