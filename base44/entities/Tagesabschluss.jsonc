{
  "name": "Tagesabschluss",
  "type": "object",
  "properties": {
    "person_email": {
      "type": "string",
      "format": "email"
    },
    "tag": {
      "type": "string",
      "format": "date",
      "description": "der Tag, auf den sich Pausen und Best\u00e4tigung beziehen"
    },
    "pausen": {
      "type": "array",
      "description": "vermerkte Pausen des Tages \u2014 z\u00e4hlen nicht als offene L\u00fccke",
      "items": {
        "type": "object",
        "properties": {
          "von": {
            "type": "string",
            "description": "Uhrzeit im Format HH:MM"
          },
          "bis": {
            "type": "string",
            "description": "Uhrzeit im Format HH:MM"
          }
        }
      }
    },
    "tagesnorm_minuten": {
      "type": "number",
      "default": 480,
      "description": "Sollarbeitszeit des Tages in Minuten"
    },
    "bestaetigt_am": {
      "type": "string",
      "format": "date-time",
      "description": "gesetzt = Buchungen dieses Tages sind festgeschrieben"
    },
    "bestaetigt_von": {
      "type": "string",
      "description": "wer den Tag best\u00e4tigt hat"
    },
    "woche_bestaetigt_am": {
      "type": "string",
      "format": "date-time",
      "description": "gesetzt am Montag der Woche = ganze Woche best\u00e4tigt"
    },
    "woche_bestaetigt_von": {
      "type": "string"
    },
    "notiz": {
      "type": "string"
    }
  },
  "required": [
    "person_email",
    "tag"
  ],
  "rls": {
    "create": {
      "data.person_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}