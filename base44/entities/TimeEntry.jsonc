{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "sprint_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string",
      "description": "optional: Aufgabe, auf die gebucht wurde"
    },
    "person_email": {
      "type": "string",
      "format": "email"
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "Buchungstag \u2014 beim Timer der Tag des STARTS"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "tats\u00e4chlicher Beginn"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "tats\u00e4chliches Ende"
    },
    "duration_minutes": {
      "type": "number",
      "description": "ungerundete Dauer in Minuten \u2014 die f\u00fchrende Gr\u00f6\u00dfe"
    },
    "hours": {
      "type": "number",
      "description": "abgeleitet aus duration_minutes (Minuten / 60, zwei Nachkommastellen)"
    },
    "note": {
      "type": "string"
    },
    "kategorie": {
      "type": "string",
      "enum": [
        "sprint",
        "support",
        "aufwand",
        "paket",
        "intern"
      ],
      "description": "Abrechnungsmodell des Projekts zum Buchungszeitpunkt \u2014 wird mitgeschrieben, nie sp\u00e4ter abgeleitet"
    },
    "taetigkeit": {
      "type": "string",
      "enum": [
        "Beratung",
        "Konzept",
        "Text",
        "Grafik",
        "Web",
        "Media",
        "QS"
      ]
    },
    "verrechenbar": {
      "type": "boolean",
      "default": true
    },
    "nicht_verrechenbar_grund": {
      "type": "string",
      "enum": [
        "kulanz",
        "interne_nacharbeit",
        "fehler",
        "einarbeitung",
        "akquise",
        "intern"
      ]
    },
    "ueber_kontingent": {
      "type": "boolean",
      "default": false
    },
    "korrektur_zu": {
      "type": "string",
      "description": "Id der Buchung, die diese Buchung korrigiert"
    },
    "quelle": {
      "type": "string",
      "enum": [
        "timer",
        "zeile",
        "luecke",
        "spur",
        "korrektur"
      ],
      "default": "timer"
    },
    "abrechenbar": {
      "type": "boolean",
      "default": true,
      "description": "abgel\u00f6st durch verrechenbar \u2014 nur noch f\u00fcr Altauswertungen mitgeschrieben"
    },
    "abrechnungsstatus": {
      "type": "string",
      "enum": [
        "offen",
        "abgerechnet",
        "verworfen"
      ],
      "default": "offen"
    },
    "billing_instruction_id": {
      "type": "string",
      "description": "Abrechnungsanweisung, mit der diese Stunde fakturiert wurde"
    },
    "abgerechnet_am": {
      "type": "string",
      "format": "date-time"
    },
    "stundensatz": {
      "type": "number",
      "description": "nur bei Kategorie 'aufwand' gesetzt"
    },
    "source": {
      "type": "string",
      "enum": [
        "bestaetigt",
        "korrigiert"
      ],
      "default": "bestaetigt",
      "description": "Wochenbest\u00e4tigung oder nachtr\u00e4gliche Korrektur"
    }
  },
  "required": [
    "project_id",
    "person_email",
    "entry_date",
    "duration_minutes"
  ],
  "rls": {
    "create": {
      "data.person_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "system_role": "pm"
          }
        },
        {
          "user_condition": {
            "system_role": "gf"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}