{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "sprint_id": {
      "type": "string"
    },
    "person_email": {
      "type": "string",
      "format": "email"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "hours": {
      "type": "number"
    },
    "note": {
      "type": "string"
    },
    "kategorie": {
      "type": "string",
      "enum": [
        "sprint",
        "support",
        "aufwand",
        "paket",
        "intern"
      ],
      "description": "Abrechnungsmodell des Projekts zum Buchungszeitpunkt \u2014 wird mitgeschrieben, nie sp\u00e4ter abgeleitet"
    },
    "abrechenbar": {
      "type": "boolean",
      "default": true
    },
    "abrechnungsstatus": {
      "type": "string",
      "enum": [
        "offen",
        "abgerechnet",
        "verworfen"
      ],
      "default": "offen"
    },
    "stundensatz": {
      "type": "number",
      "description": "nur bei Kategorie 'aufwand' gesetzt"
    },
    "source": {
      "type": "string",
      "enum": [
        "bestaetigt",
        "korrigiert"
      ],
      "default": "bestaetigt",
      "description": "Wochenbest\u00e4tigung oder nachtr\u00e4gliche Korrektur"
    }
  },
  "required": [
    "project_id",
    "person_email",
    "entry_date",
    "hours"
  ]
}