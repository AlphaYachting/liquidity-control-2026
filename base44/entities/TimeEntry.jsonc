{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "person_email": {
      "type": "string",
      "format": "email"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "hours": {
      "type": "number"
    },
    "note": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "bestaetigt",
        "korrigiert"
      ],
      "default": "bestaetigt",
      "description": "Wochenbest\u00e4tigung oder nachtr\u00e4gliche Korrektur"
    }
  },
  "required": [
    "project_id",
    "person_email",
    "entry_date",
    "hours"
  ]
}