{
  "name": "TimeEntry",
  "properties": {
    "abgerechnet_am": {
      "format": "date-time",
      "type": "string"
    },
    "abrechenbar": {
      "default": true,
      "description": "abgel\u00f6st durch verrechenbar \u2014 nur noch f\u00fcr Altauswertungen mitgeschrieben",
      "type": "boolean"
    },
    "abrechnungsstatus": {
      "default": "offen",
      "enum": [
        "offen",
        "abgerechnet",
        "verworfen"
      ],
      "type": "string"
    },
    "billing_instruction_id": {
      "description": "Abrechnungsanweisung, mit der diese Stunde fakturiert wurde",
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "dauer_geschaetzt": {
      "default": false,
      "description": "Altbuchung \u2014 duration_minutes aus gerundeten Stunden abgeleitet, nicht echt gemessen",
      "type": "boolean"
    },
    "duration_minutes": {
      "description": "ungerundete Dauer in Minuten \u2014 die f\u00fchrende Gr\u00f6\u00dfe",
      "type": "number"
    },
    "ended_at": {
      "description": "tats\u00e4chliches Ende",
      "format": "date-time",
      "type": "string"
    },
    "entry_date": {
      "description": "Buchungstag \u2014 beim Timer der Tag des STARTS",
      "format": "date",
      "type": "string"
    },
    "hours": {
      "description": "abgeleitet aus duration_minutes",
      "type": "number"
    },
    "kategorie": {
      "description": "Abrechnungsmodell des Projekts zum Buchungszeitpunkt",
      "enum": [
        "sprint",
        "support",
        "aufwand",
        "paket",
        "intern"
      ],
      "type": "string"
    },
    "korrektur_zu": {
      "description": "Id der Buchung, die diese Buchung korrigiert",
      "type": "string"
    },
    "laufende_id": {
      "description": "Id der LaufendeZeitbuchung, aus der diese Buchung entstand \u2014 wird nur von zeitStoppen gesetzt und macht den Aufruf wiederholbar",
      "type": "string"
    },
    "mehrleistung": {
      "default": false,
      "description": "Mehraufwand: Zusatzwunsch des Kunden ausserhalb des Auftragsumfangs \u2014 tr\u00e4gt die Begr\u00fcndung f\u00fcr Mehrkosten",
      "type": "boolean"
    },
    "module_template_id": {
      "description": "Leistungsbereich der Buchung",
      "type": "string"
    },
    "nicht_verrechenbar_grund": {
      "enum": [
        "kulanz",
        "interne_nacharbeit",
        "fehler",
        "einarbeitung",
        "akquise",
        "intern"
      ],
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "person_email": {
      "format": "email",
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "quelle": {
      "default": "timer",
      "enum": [
        "timer",
        "zeile",
        "luecke",
        "spur",
        "korrektur"
      ],
      "type": "string"
    },
    "source": {
      "default": "bestaetigt",
      "description": "Wochenbest\u00e4tigung oder nachtr\u00e4gliche Korrektur",
      "enum": [
        "bestaetigt",
        "korrigiert"
      ],
      "type": "string"
    },
    "sprint_id": {
      "type": "string"
    },
    "started_at": {
      "description": "tats\u00e4chlicher Beginn",
      "format": "date-time",
      "type": "string"
    },
    "stundensatz": {
      "description": "nur bei Kategorie 'aufwand' gesetzt",
      "type": "number"
    },
    "taetigkeit": {
      "description": "Art der Arbeit in der Zeitbuchung \u2014 wird immer vorbelegt (Meeting w\u00e4hlt man bewusst), die sieben Rollen bleiben der Aufgabenzuteilung",
      "enum": [
        "beratung",
        "vertrieb",
        "umsetzung",
        "meeting"
      ],
      "type": "string"
    },
    "ticket_id": {
      "description": "optional: Aufgabe, auf die gebucht wurde",
      "type": "string"
    },
    "ueber_kontingent": {
      "default": false,
      "type": "boolean"
    },
    "verrechenbar": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "person_email",
    "entry_date",
    "duration_minutes"
  ],
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}