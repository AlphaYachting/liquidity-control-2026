{
  "name": "CrmActivity",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Verkn\u00fcpfter CrmDeal"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "note",
        "stage_change",
        "system"
      ],
      "default": "note"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "activity_date": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "meeting",
        "intern"
      ],
      "description": "Kanal der Kommunikation"
    },
    "direction": {
      "type": "string",
      "enum": [
        "eingehend",
        "ausgehend"
      ],
      "description": "Richtung der Kommunikation"
    },
    "intent": {
      "type": "string",
      "description": "Absicht der gesendeten Nachricht: antwort, terminvorschlag, angebot, nachfassen, rueckfrage, absage"
    },
    "body": {
      "type": "string",
      "description": "Gesendeter Text der Nachricht"
    }
  },
  "required": [
    "deal_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {}
  }
}