{
  "name": "CrmActivity",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Verkn\u00fcpfter CrmDeal"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "note",
        "stage_change",
        "system"
      ],
      "default": "note"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "activity_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "deal_id"
  ]
}