{
  "name": "AddOnTicketTemplate",
  "type": "object",
  "properties": {
    "add_on_block_id": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Beratung",
        "Konzept",
        "Text",
        "Grafik",
        "Web",
        "Media",
        "QS"
      ]
    },
    "target_hours": {
      "type": "number"
    },
    "milestone_state": {
      "type": "string",
      "enum": [
        "input",
        "produktion",
        "pruefung",
        "kundenfeedback"
      ],
      "default": "produktion"
    },
    "blocks_others": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "add_on_block_id",
    "order",
    "title"
  ]
}