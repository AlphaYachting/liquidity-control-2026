{
  "name": "ToolCost",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "design",
        "marketing",
        "programming",
        "project_management",
        "general",
        "other"
      ]
    },
    "annual_cost": {
      "type": "number",
      "default": 0
    },
    "monthly_cost": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "overdue",
        "unclear",
        "not_invoiced"
      ],
      "default": "pending"
    },
    "subscription_start": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_interval": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly",
        "one_time",
        "unclear"
      ],
      "default": "monthly"
    },
    "needed": {
      "type": "boolean",
      "default": true
    },
    "customer_recharge": {
      "type": "string"
    },
    "info": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "risk_flag": {
      "type": "boolean",
      "default": false
    },
    "cancellation_possible": {
      "type": "boolean",
      "default": false
    },
    "decision_status": {
      "type": "string",
      "enum": [
        "keep",
        "cancel",
        "review",
        "undecided"
      ],
      "default": "undecided"
    },
    "cancellation_effective_date": {
      "type": "string",
      "format": "date",
      "description": "Ab diesem Tag entf\u00e4llt der Dienst \u2014 ab dem betreffenden Monat wird er in der Liquidit\u00e4tsplanung nicht mehr angesetzt"
    },
    "cancellation_note": {
      "type": "string",
      "description": "Begr\u00fcndung der K\u00fcndigungsentscheidung \u2014 Grundlage f\u00fcr das Freigabeersuchen nach \u00a7 46 IO"
    },
    "source_sheet": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "source_row": {
      "type": "number"
    }
  },
  "required": [
    "tool_name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}