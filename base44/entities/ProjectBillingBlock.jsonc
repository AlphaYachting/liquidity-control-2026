{
  "name": "ProjectBillingBlock",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Linked LiquidityProject ID"
    },
    "confirmed_order_id": {
      "type": "string",
      "description": "Linked ConfirmedOrder ID"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "amount_net": {
      "type": "number",
      "default": 0
    },
    "amount_gross": {
      "type": "number",
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "billing_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 planned invoicing month"
    },
    "planned_invoice_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_readiness_status": {
      "type": "string",
      "enum": [
        "not_ready",
        "in_progress",
        "ready",
        "invoiced",
        "paid"
      ],
      "default": "not_ready"
    },
    "work_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked"
      ],
      "default": "not_started"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "probability_percent": {
      "type": "number",
      "default": 90
    },
    "responsible_person": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "awork_task_list_id": {
      "type": "string"
    },
    "awork_task_list_name": {
      "type": "string"
    },
    "awork_task_ids": {
      "type": "string",
      "description": "JSON array of awork task UUIDs"
    },
    "awork_custom_field_value": {
      "type": "string"
    },
    "awork_mapping_type": {
      "type": "string",
      "enum": [
        "task_list",
        "tasks",
        "custom_field",
        "none"
      ],
      "default": "none"
    },
    "awork_progress_percent": {
      "type": "number",
      "default": 0
    },
    "awork_tasks_total": {
      "type": "number",
      "default": 0
    },
    "awork_tasks_done": {
      "type": "number",
      "default": 0
    },
    "awork_tasks_open": {
      "type": "number",
      "default": 0
    },
    "awork_tasks_blocked": {
      "type": "number",
      "default": 0
    },
    "awork_responsible_person": {
      "type": "string"
    },
    "awork_last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "awork_readiness_signal": {
      "type": "string",
      "enum": [
        "unknown",
        "not_ready",
        "review_needed",
        "likely_ready",
        "ready_candidate",
        "blocked"
      ],
      "default": "unknown"
    },
    "awork_signal_reason": {
      "type": "string"
    },
    "awork_last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "awork_adjusted_probability": {
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "title",
    "amount_net"
  ]
}