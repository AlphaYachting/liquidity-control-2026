{
  "name": "ProjectBillingBlock",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Linked LiquidityProject ID"
    },
    "confirmed_order_id": {
      "type": "string",
      "description": "Linked ConfirmedOrder ID"
    },
    "title": {
      "type": "string",
      "description": "e.g. Strategie, Design, Entwicklung Phase 1"
    },
    "description": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "amount_net": {
      "type": "number",
      "default": 0
    },
    "amount_gross": {
      "type": "number",
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "billing_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 planned invoicing month"
    },
    "planned_invoice_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_readiness_status": {
      "type": "string",
      "enum": [
        "not_ready",
        "in_progress",
        "ready",
        "invoiced",
        "paid"
      ],
      "default": "not_ready"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "probability_percent": {
      "type": "number",
      "default": 90
    },
    "responsible_person": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "title",
    "amount_net"
  ]
}