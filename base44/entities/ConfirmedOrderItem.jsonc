{
  "name": "ConfirmedOrderItem",
  "type": "object",
  "properties": {
    "confirmed_order_id": {
      "type": "string",
      "description": "Linked ConfirmedOrder ID"
    },
    "position": {
      "type": "number",
      "description": "Position number (1, 2, 3...)"
    },
    "title": {
      "type": "string",
      "description": "Leistungsbezeichnung"
    },
    "description": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "default": "pauschal"
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "is_discount": {
      "type": "boolean",
      "default": false,
      "description": "True for discount/Rabatt rows"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked"
      ],
      "default": "not_started"
    },
    "notes": {
      "type": "string"
    },
    "lieferumfang": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Einzelleistungen der Position im Wortlaut"
    },
    "korrekturschleifen": {
      "type": "number",
      "description": "Nur wenn f\u00fcr diese Position abweichend vom Auftragswert"
    },
    "leistungszeitraum": {
      "type": "string",
      "description": "Dauer bzw. Termin dieser Position, falls genannt"
    },
    "abrechnung": {
      "type": "string",
      "enum": [
        "einmalig",
        "monatlich",
        "nach_aufwand"
      ],
      "default": "einmalig"
    },
    "optional_im_angebot": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "confirmed_order_id",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}