{
  "name": "CrmInboxItem",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "phone_ai",
        "email",
        "manual"
      ],
      "default": "manual"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Inhalt der Anfrage / Gespr\u00e4chszusammenfassung der Telefon-KI"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "email_message_id": {
      "type": "string",
      "description": "Alt: 'thread:<id>' \u2014 neue Eintr\u00e4ge nutzen thread_id"
    },
    "thread_id": {
      "type": "string",
      "description": "sauberer Bezug zum E-Mail-Thread in der externen DB"
    },
    "track": {
      "type": "string",
      "enum": [
        "lead",
        "support"
      ],
      "default": "lead",
      "description": "Bearbeitungsspur im Posteingang \u2014 Lead-Verdacht oder Support/St\u00f6rung"
    },
    "suggested_action": {
      "type": "string",
      "enum": [
        "supportticket",
        "anfrage",
        "kein_lead"
      ],
      "description": "KI-Vorklassifizierung \u2014 Empfehlung, keine Sperre"
    },
    "request_nature": {
      "type": "string",
      "enum": [
        "stoerung",
        "aenderung_bestehend",
        "neue_leistung",
        "sonstiges"
      ],
      "description": "Art des Anliegens laut KI"
    },
    "is_known_customer": {
      "type": "boolean",
      "default": false,
      "description": "Absenderdomain geh\u00f6rt zu einem Bestandskunden"
    },
    "customer_match": {
      "type": "string",
      "enum": [
        "sicher",
        "unsicher",
        "unbekannt"
      ],
      "default": "unbekannt"
    },
    "inquiry_type": {
      "type": "string",
      "enum": [
        "angebotsanfrage",
        "erweiterung_bestandskunde",
        "laufende_projektkommunikation",
        "support_stoerung",
        "verwaltung",
        "kein_geschaeft"
      ],
      "description": "Stufe 1 der Einstufung"
    },
    "buying_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "belegte Kaufsignale im Klartext (Signal \u2014 Textstelle)"
    },
    "signal_count": {
      "type": "number",
      "default": 0
    },
    "lead_strength": {
      "type": "string",
      "enum": [
        "stark",
        "schwach"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "offen",
        "lead",
        "zugeordnet",
        "nur_antwort",
        "verworfen"
      ],
      "default": "offen"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismiss_reason": {
      "type": "string",
      "description": "Pflicht beim Verwerfen \u2014 flie\u00dft in die n\u00e4chste Einstufung ein"
    },
    "suggested_pipeline": {
      "type": "string",
      "enum": [
        "new_business",
        "existing_customer",
        "unknown"
      ],
      "default": "unknown",
      "description": "KI-Einsch\u00e4tzung: Neukunde oder Bestandskunde"
    },
    "matched_customer_name": {
      "type": "string",
      "description": "Erkannter Bestandskunde"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "converted",
        "dismissed"
      ],
      "default": "new"
    },
    "linked_deal_id": {
      "type": "string"
    },
    "linked_ticket_id": {
      "type": "string",
      "description": "Aus der Support-Anfrage entstandenes Ticket"
    }
  },
  "required": [
    "source"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {},
    "delete": {}
  }
}