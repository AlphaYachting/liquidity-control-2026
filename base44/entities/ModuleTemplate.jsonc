{
  "name": "ModuleTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "z. B. Landingpage, Social-Media-Audit, Logoentwicklung"
    },
    "description": {
      "type": "string"
    },
    "target_hours": {
      "type": "number",
      "description": "kalkulierter Sollaufwand"
    },
    "target_focus_days": {
      "type": "number"
    },
    "standard_price": {
      "type": "number"
    },
    "default_arbeitsmodell": {
      "type": "string",
      "enum": [
        "sprint",
        "support",
        "container",
        "intern"
      ],
      "default": "sprint",
      "description": "Arbeitsmodell, in dem dieses Modul \u00fcblicherweise verkauft wird"
    },
    "bundle_key": {
      "type": "string",
      "description": "gruppiert Phasen-Module zu EINEM Katalog-Produkt, z. B. website_neubau"
    },
    "bundle_order": {
      "type": "number",
      "description": "Reihenfolge der Phase innerhalb des Bundles (1..n)"
    },
    "is_hard_gate": {
      "type": "boolean",
      "default": false,
      "description": "Phase mit hartem Freeze (z. B. Design)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}