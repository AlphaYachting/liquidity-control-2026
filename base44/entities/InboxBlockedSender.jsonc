{
  "name": "InboxBlockedSender",
  "properties": {
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "label": {
      "description": "Klartext, wozu der Filter dient",
      "type": "string"
    },
    "mode": {
      "default": "ausblenden",
      "description": "ausblenden = erscheint nie im Posteingang (vertraulich); verwaltung = erscheint im Posteingang unter dem Filter Verwaltung (Lieferanten, Beh\u00f6rden, Steuerberatung)",
      "enum": [
        "ausblenden",
        "verwaltung"
      ],
      "type": "string"
    },
    "value": {
      "description": "E-Mail-Adresse oder Domain (z. B. unseranwalt.at)",
      "type": "string"
    }
  },
  "required": [
    "value"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}