{
  "name": "TicketTemplate",
  "type": "object",
  "properties": {
    "module_template_id": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Beratung",
        "Konzept",
        "Text",
        "Grafik",
        "Web",
        "Media",
        "QS"
      ]
    },
    "target_hours": {
      "type": "number"
    },
    "milestone_state": {
      "type": "string",
      "enum": [
        "input",
        "produktion",
        "pruefung",
        "kundenfeedback"
      ],
      "default": "produktion",
      "description": "in welchem Milestone-Zustand dieses Ticket bearbeitet wird"
    },
    "blocks_others": {
      "type": "boolean",
      "default": false,
      "description": "blockiert andere Aufgaben, wenn es liegen bleibt"
    }
  },
  "required": [
    "module_template_id",
    "order",
    "title",
    "role",
    "target_hours",
    "milestone_state"
  ]
}