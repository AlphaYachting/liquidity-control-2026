{
  "name": "TicketTemplate",
  "properties": {
    "art": {
      "default": "einmalig",
      "enum": [
        "einmalig",
        "routine"
      ],
      "type": "string"
    },
    "blocks_others": {
      "default": false,
      "description": "blockiert andere Aufgaben, wenn es liegen bleibt",
      "type": "boolean"
    },
    "fenster_tage": {
      "default": 0,
      "description": "Arbeitstage nach der F\u00e4lligkeit, in denen die Aufgabe noch nicht als \u00fcberf\u00e4llig gilt",
      "type": "number"
    },
    "milestone_state": {
      "default": "produktion",
      "description": "in welchem Milestone-Zustand dieses Ticket bearbeitet wird \u2014 bei Routinen immer produktion",
      "enum": [
        "input",
        "produktion",
        "pruefung",
        "kundenfeedback"
      ],
      "type": "string"
    },
    "module_template_id": {
      "type": "string"
    },
    "optional": {
      "default": false,
      "description": "bei der Projektanlage nicht vorausgew\u00e4hlt",
      "type": "boolean"
    },
    "order": {
      "type": "number"
    },
    "rhythmus": {
      "description": "nur bei art = routine",
      "enum": [
        "woechentlich",
        "14taegig",
        "monatlich",
        "2monatlich",
        "quartalsweise",
        "halbjaehrlich",
        "jaehrlich",
        "manuell"
      ],
      "type": "string"
    },
    "role": {
      "enum": [
        "Beratung",
        "Konzept",
        "Text",
        "Grafik",
        "Web",
        "Media",
        "QS"
      ],
      "type": "string"
    },
    "target_hours": {
      "type": "number"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "module_template_id",
    "order",
    "title",
    "role",
    "target_hours",
    "milestone_state"
  ],
  "type": "object"
}