{
  "name": "ProjektIntelligenzGespraech",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Arbeitsprojekt (Project.id), zu dem das Gespr\u00e4ch geh\u00f6rt; nur bei einem Cockpit ohne Arbeitsprojekt die Cockpit-ID"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation der Projektintelligenz"
    },
    "user_email": {
      "type": "string",
      "description": "Person, der das Gespr\u00e4ch geh\u00f6rt \u2014 jede Person hat pro Projekt ihr eigenes Gespr\u00e4ch"
    },
    "letzter_zugriff": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "conversation_id"
  ]
}