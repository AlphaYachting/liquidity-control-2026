{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string"
    },
    "system_role": {
      "type": "string",
      "enum": [
        "teammitglied",
        "pm",
        "gf"
      ],
      "default": "teammitglied"
    },
    "process_owner": {
      "type": "boolean",
      "default": false,
      "description": "darf Bausteine in den Katalog aufnehmen"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Beratung",
          "Konzept",
          "Text",
          "Grafik",
          "Web",
          "Media",
          "QS"
        ]
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "#2E5AAC",
        "#1F6F6B",
        "#5B3E96",
        "#8A4B2A",
        "#465A70",
        "#7A2E5E",
        "#145C86",
        "#33415C"
      ],
      "description": "Personenfarbe \u2014 lebt ausschlie\u00dflich in der Fl\u00e4che des K\u00fcrzel-Chips"
    },
    "weekly_focus_days": {
      "type": "number",
      "default": 4,
      "description": "Nenner der Auslastungsrechnung"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "email",
    "name",
    "system_role",
    "roles"
  ]
}