{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string"
    },
    "system_role": {
      "type": "string",
      "enum": [
        "teammitglied",
        "pm",
        "gf"
      ],
      "default": "teammitglied"
    },
    "process_owner": {
      "type": "boolean",
      "default": false,
      "description": "darf Bausteine in den Katalog aufnehmen"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Beratung",
          "Konzept",
          "Text",
          "Grafik",
          "Web",
          "Media",
          "QS"
        ]
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "#1D4ED8",
        "#0E9488",
        "#16A34A",
        "#CA8A04",
        "#EA580C",
        "#DC2626",
        "#DB2777",
        "#9333EA",
        "#475569"
      ],
      "description": "Personenfarbe \u2014 klar unterscheidbare Grundt\u00f6ne, lebt in der Fl\u00e4che des K\u00fcrzel-Chips"
    },
    "weekly_focus_days": {
      "type": "number",
      "default": 4,
      "description": "Nenner der Auslastungsrechnung"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "email",
    "name",
    "system_role",
    "roles"
  ]
}