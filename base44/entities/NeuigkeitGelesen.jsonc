{
  "description": "Wer eine Ausgabe \u201eWas ist neu\u201c mit \u201eVerstanden\u201c best\u00e4tigt hat \u2014 je Person und Ausgabe ein Datensatz.",
  "name": "NeuigkeitGelesen",
  "properties": {
    "gelesen_am": {
      "format": "date-time",
      "type": "string"
    },
    "neuigkeit_id": {
      "type": "string"
    },
    "person_email": {
      "format": "email",
      "type": "string"
    }
  },
  "required": [
    "neuigkeit_id",
    "person_email"
  ],
  "rls": {
    "create": {
      "data.person_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.person_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}