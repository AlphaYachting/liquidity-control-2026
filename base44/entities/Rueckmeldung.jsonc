{
  "name": "Rueckmeldung",
  "properties": {
    "antwort": {
      "description": "Antwort an die meldende Person",
      "type": "string"
    },
    "art": {
      "description": "Von der meldenden Person selbst gew\u00e4hlt",
      "enum": [
        "fehler",
        "wunsch",
        "anregung"
      ],
      "type": "string"
    },
    "bearbeitet_am": {
      "format": "date-time",
      "type": "string"
    },
    "bilder": {
      "description": "Screenshots (Datei-URLs)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "bildschirm": {
      "description": "Fenstergr\u00f6\u00dfe Breite x H\u00f6he",
      "type": "string"
    },
    "blockiert": {
      "default": false,
      "description": "Nur bei Fehler: Person kommt ohne L\u00f6sung nicht weiter",
      "type": "boolean"
    },
    "browser": {
      "type": "string"
    },
    "person_email": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "project_id": {
      "description": "Projekt, das beim Melden offen war",
      "type": "string"
    },
    "seite": {
      "description": "Pfad der App-Seite, auf der gemeldet wurde",
      "type": "string"
    },
    "seiten_titel": {
      "type": "string"
    },
    "status": {
      "default": "neu",
      "enum": [
        "neu",
        "angesehen",
        "umgesetzt",
        "spaeter",
        "abgelehnt"
      ],
      "type": "string"
    },
    "text": {
      "description": "Beschreibung der Person",
      "type": "string"
    },
    "ticket_id": {
      "description": "Ticket, das beim Melden offen war",
      "type": "string"
    }
  },
  "required": [
    "art",
    "text",
    "person_email"
  ],
  "rls": {
    "create": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}