{
  "name": "RecurringContract",
  "properties": {
    "annual_amount": {
      "default": 0,
      "type": "number"
    },
    "awork_company_id": {
      "description": "Verkn\u00fcpftes Unternehmen in awork \u2014 alle seine Projekte geh\u00f6ren zu diesem Kunden",
      "type": "string"
    },
    "awork_company_name": {
      "type": "string"
    },
    "billing_interval": {
      "default": "monthly",
      "enum": [
        "monthly",
        "quarterly",
        "yearly",
        "once",
        "by_effort"
      ],
      "type": "string"
    },
    "contract_type": {
      "enum": [
        "online_marketing",
        "maintenance",
        "support",
        "hosting",
        "domain",
        "other"
      ],
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "domain": {
      "description": "Domain-Name z.B. example.com",
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "in_liquiditaet": {
      "default": true,
      "description": "false = Vertrag wird in der Liquidit\u00e4tsplanung nicht als k\u00fcnftiger Eingang angesetzt (z. B. Dublette oder anders verrechnet)",
      "type": "boolean"
    },
    "monthly_fixed_price": {
      "default": 0,
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "one_time_payment": {
      "default": 0,
      "type": "number"
    },
    "order_number": {
      "type": "string"
    },
    "project_manager": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "source_row": {
      "type": "number"
    },
    "source_sheet": {
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "pending",
        "unclear"
      ],
      "type": "string"
    }
  },
  "required": [
    "customer"
  ],
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}