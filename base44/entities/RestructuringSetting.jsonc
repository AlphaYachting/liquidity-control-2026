{
  "name": "RestructuringSetting",
  "type": "object",
  "properties": {
    "insolvency_opening_date": {
      "type": "string",
      "format": "date",
      "description": "Stichtag Insolvenzer\u00f6ffnung \u2014 f\u00fcr Alt-/Neuforderungs-Split"
    },
    "wip_blended_hourly_rate": {
      "type": "number",
      "default": 0,
      "description": "Einheitlicher Mischsatz f\u00fcr WIP-Bewertung (EUR/Stunde)"
    },
    "planning_horizon_months": {
      "type": "number",
      "default": 12,
      "description": "Forecast-Zeitraum in Monaten (12\u201324)"
    },
    "plan_start_date": {
      "type": "string",
      "format": "date",
      "description": "Beginn der Woche 1 des Plans \u2014 immer ein Montag, fixer Planbeginn (nicht rollierend)"
    },
    "reporting_hearing_date": {
      "type": "string",
      "format": "date",
      "description": "Termin der Berichtstagsatzung, an dem der Plan beurteilt wird"
    },
    "plan_weeks": {
      "type": "number",
      "default": 13,
      "description": "Anzahl der Planwochen"
    },
    "worst_case_inflow_factor": {
      "type": "number",
      "default": 0.7,
      "description": "Faktor f\u00fcr Worst-Case-Szenario: alle Einzahlungen \u00d7 Faktor, Auszahlungen unver\u00e4ndert"
    },
    "default_vat_rate": {
      "type": "number",
      "default": 20,
      "description": "Standard-Umsatzsteuersatz in Prozent \u2014 hilfsweise Umrechnung Netto auf Brutto"
    },
    "amounts_are_gross": {
      "type": "boolean",
      "default": true,
      "description": "Leitw\u00e4hrung der Planung: true = Betr\u00e4ge brutto, false = netto"
    },
    "default_payment_pattern_id": {
      "type": "string",
      "description": "Standard-Zahlungsstaffel (PaymentPattern) f\u00fcr die Verteilung von Rechnungsbetr\u00e4gen auf Wochen"
    },
    "max_monthly_billing_gross": {
      "type": "number",
      "default": 45000,
      "description": "Kapazit\u00e4tsgrenze: maximal fakturierbarer Betrag brutto je Monat aus dem Auftragsbestand"
    },
    "billing_to_cash_weeks": {
      "type": "number",
      "default": 4,
      "description": "Zeitversatz in Wochen zwischen Leistung/Rechnungslegung und Zahlungseingang"
    },
    "collect_rate_0_30": {
      "type": "number",
      "default": 90,
      "description": "Einbringlichkeitsquote in Prozent \u2014 f\u00e4llig innerhalb der letzten 30 Tage"
    },
    "collect_week_from_0_30": {
      "type": "number",
      "default": 1
    },
    "collect_week_to_0_30": {
      "type": "number",
      "default": 2
    },
    "collect_rate_31_60": {
      "type": "number",
      "default": 70,
      "description": "Einbringlichkeitsquote in Prozent \u2014 31 bis 60 Tage \u00fcberf\u00e4llig"
    },
    "collect_week_from_31_60": {
      "type": "number",
      "default": 1
    },
    "collect_week_to_31_60": {
      "type": "number",
      "default": 4
    },
    "collect_rate_61_90": {
      "type": "number",
      "default": 40,
      "description": "Einbringlichkeitsquote in Prozent \u2014 61 bis 90 Tage \u00fcberf\u00e4llig"
    },
    "collect_week_from_61_90": {
      "type": "number",
      "default": 2
    },
    "collect_week_to_61_90": {
      "type": "number",
      "default": 6
    },
    "collect_rate_90_plus": {
      "type": "number",
      "default": 15,
      "description": "Einbringlichkeitsquote in Prozent \u2014 \u00fcber 90 Tage \u00fcberf\u00e4llig"
    },
    "collect_week_from_90_plus": {
      "type": "number",
      "default": 4
    },
    "collect_week_to_90_plus": {
      "type": "number",
      "default": 8
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}