{
  "name": "RestructuringSetting",
  "type": "object",
  "properties": {
    "insolvency_opening_date": {
      "type": "string",
      "format": "date",
      "description": "Stichtag Insolvenzer\u00f6ffnung \u2014 f\u00fcr Alt-/Neuforderungs-Split"
    },
    "wip_blended_hourly_rate": {
      "type": "number",
      "default": 0,
      "description": "Einheitlicher Mischsatz f\u00fcr WIP-Bewertung (EUR/Stunde)"
    },
    "planning_horizon_months": {
      "type": "number",
      "default": 12,
      "description": "Forecast-Zeitraum in Monaten (12\u201324)"
    },
    "plan_start_date": {
      "type": "string",
      "format": "date",
      "description": "Beginn der Woche 1 des Plans \u2014 immer ein Montag, fixer Planbeginn (nicht rollierend)"
    },
    "reporting_hearing_date": {
      "type": "string",
      "format": "date",
      "description": "Termin der Berichtstagsatzung, an dem der Plan beurteilt wird"
    },
    "plan_weeks": {
      "type": "number",
      "default": 13,
      "description": "Anzahl der Planwochen"
    },
    "worst_case_inflow_factor": {
      "type": "number",
      "default": 0.7,
      "description": "Faktor f\u00fcr Worst-Case-Szenario: alle Einzahlungen \u00d7 Faktor, Auszahlungen unver\u00e4ndert"
    },
    "default_vat_rate": {
      "type": "number",
      "default": 20,
      "description": "Standard-Umsatzsteuersatz in Prozent"
    },
    "amounts_are_gross": {
      "type": "boolean",
      "default": true,
      "description": "Leitw\u00e4hrung der Planung: true = Betr\u00e4ge brutto, false = netto"
    },
    "default_payment_pattern_id": {
      "type": "string",
      "description": "Standard-Zahlungsstaffel (PaymentPattern) f\u00fcr die Verteilung von Rechnungsbetr\u00e4gen auf Wochen"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}