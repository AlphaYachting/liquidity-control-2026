{
  "name": "LiquidityProject",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "on_hold",
        "cancelled",
        "unclear"
      ],
      "default": "active"
    },
    "customer": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "project_manager": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "web_project",
        "design",
        "programming",
        "consulting",
        "marketing",
        "other"
      ]
    },
    "source_sheet": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "total_net_amount": {
      "type": "number",
      "default": 0
    },
    "already_invoiced_amount": {
      "type": "number",
      "default": 0
    },
    "open_amount": {
      "type": "number",
      "default": 0
    },
    "external_costs": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "notes_next_invoice": {
      "type": "string",
      "description": "PM-Anmerkungen f\u00fcr die n\u00e4chste Rechnung \u2014 wird als Kontext f\u00fcr BillingInstruction genutzt"
    },
    "fixed_billing_expected": {
      "type": "boolean",
      "default": false
    },
    "uncertain_billing": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "risk_status": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "none"
    },
    "expected_invoice_month": {
      "type": "string"
    },
    "expected_invoice_date": {
      "type": "string",
      "format": "date"
    },
    "monthly_values": {
      "type": "object",
      "description": "Monthly planned/actual values Jan-Dec"
    },
    "import_batch_id": {
      "type": "string"
    },
    "source_row": {
      "type": "number"
    },
    "awork_project_id": {
      "type": "string",
      "description": "Linked awork project ID"
    },
    "awork_project_name": {
      "type": "string"
    },
    "awork_project_status": {
      "type": "string"
    },
    "awork_progress_percent": {
      "type": "number",
      "default": 0
    },
    "awork_last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "real_progress_checked": {
      "type": "boolean",
      "default": false,
      "description": "Hat der PM den awork-Fortschritt validiert?"
    },
    "real_progress_percent": {
      "type": "number",
      "default": 0,
      "description": "Vom PM korrigierter tats\u00e4chlicher Fortschritt"
    },
    "progress_difference_reason": {
      "type": "string",
      "description": "Begr\u00fcndung wenn awork-Fortschritt korrigiert wurde"
    },
    "billing_relevance_status": {
      "type": "string",
      "enum": [
        "active_billing_relevant",
        "future_billing_relevant",
        "inactive",
        "archived",
        "not_billing_relevant",
        "needs_review"
      ],
      "default": "active_billing_relevant",
      "description": "Klassifizierung f\u00fcr aktive Abrechnungsansicht basierend auf PM-Excel-Reset"
    },
    "is_active_for_billing": {
      "type": "boolean",
      "default": true,
      "description": "Erscheint im Projekt-Cockpit und Forecast"
    },
    "excluded_from_project_cockpit": {
      "type": "boolean",
      "default": false
    },
    "excluded_from_forecast": {
      "type": "boolean",
      "default": false
    },
    "exclusion_reason": {
      "type": "string"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by": {
      "type": "string"
    },
    "archive_source": {
      "type": "string",
      "enum": [
        "excel_master_reset",
        "manual",
        "auto_cleanup",
        "sevdesk_sync"
      ],
      "description": "Quelle der Archivierung"
    },
    "excel_reset_batch_id": {
      "type": "string",
      "description": "MasterImportSession ID des letzten Excel-Resets"
    },
    "excel_total_order_net": {
      "type": "number",
      "default": 0
    },
    "excel_already_invoiced_net": {
      "type": "number",
      "default": 0
    },
    "excel_open_amount_net": {
      "type": "number",
      "default": 0
    },
    "excel_expected_current_month_net": {
      "type": "number",
      "default": 0
    },
    "excel_expected_next_month_net": {
      "type": "number",
      "default": 0
    },
    "excel_last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_name"
  ]
}